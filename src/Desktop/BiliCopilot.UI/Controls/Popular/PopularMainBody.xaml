<?xml version="1.0" encoding="utf-8" ?>
<local:PopularPageControlBase
    x:Class="BiliCopilot.UI.Controls.Popular.PopularMainBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Popular"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="RecommendStyle" x:DataType="items:VideoItemViewModel">
            <components:VideoCardControl Style="{StaticResource RecommendVideoCardStyle}" ViewModel="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="HotStyle" x:DataType="items:VideoItemViewModel">
            <components:VideoCardControl Style="{StaticResource HotVideoCardStyle}" ViewModel="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="RankStyle" x:DataType="items:VideoItemViewModel">
            <components:VideoCardControl Style="{StaticResource RankVideoCardStyle}" ViewModel="{x:Bind}" />
        </DataTemplate>
        <ext:VideoCardTemplateSelector
            x:Key="CardSelector"
            HotTemplate="{StaticResource HotStyle}"
            RankTemplate="{StaticResource RankStyle}"
            RecommendTemplate="{StaticResource RecommendStyle}" />
        <DataTemplate x:Key="PopularVideoTemplate" x:DataType="items:VideoItemViewModel">
            <Grid Opacity="{x:Bind OpenedCardOpacity, Mode=OneWay}">
                <ContentControl
                    Content="{x:Bind}"
                    ContentTemplateSelector="{StaticResource CardSelector}"
                    Style="{StaticResource AppContentControlStyle}" />
                <Border
                    IsHitTestVisible="False"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Visibility="{x:Bind IsOpenedBorderVisible, Mode=OneWay}" />
                <components:AnimatedRainbowBorder
                    IsActive="{x:Bind IsOpenedRainbowBorderVisible, Mode=OneWay}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Visibility="{x:Bind IsOpenedRainbowBorderVisible, Mode=OneWay}" />
                <Border
                    Margin="8"
                    Padding="7,3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Visibility="{x:Bind IsOpenedBadgeVisible, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ic:SymbolIcon FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Symbol="Checkmark" />
                        <TextBlock Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{ext:Locale Name=LastOpened}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <controls:IncrementVerticalScrollControl x:Name="View" LoadMoreCommand="{x:Bind ViewModel.LoadVideosCommand}">
            <controls:IncrementVerticalScrollControl.Element>
                <Grid Margin="0,16">
                    <repeater:AppRepeater
                        x:Name="VideoRepeater"
                        ItemsSource="{x:Bind ViewModel.Videos}"
                        ItemTemplate="{StaticResource PopularVideoTemplate}"
                        Layout="{StaticResource MomentLayout}">
                    </repeater:AppRepeater>
                </Grid>
            </controls:IncrementVerticalScrollControl.Element>
        </controls:IncrementVerticalScrollControl>
        <base:LoadingWidget Text="{ext:Locale Name=LoadingAndWait}" Visibility="{x:Bind ViewModel.IsVideoLoading, Mode=OneWay}" />
    </Grid>
</local:PopularPageControlBase>
